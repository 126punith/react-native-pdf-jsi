#!/bin/sh
# Removes Cursor attribution lines (Made-with / Co-authored-by) if the editor
# or tooling injected them. commit-msg runs this again after any trailers are added.
# Enable this hook directory once per clone:
#   git config core.hooksPath .githooks
# Optional commit template (opens in editor for git commit without -m):
#   git config commit.template .gitmessage

msg_file=$1
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

pattern='^(Made-with|Co-authored-by):[[:space:]]*Cursor'
if grep -qiE "$pattern" "$msg_file" 2>/dev/null; then
  tmp="${msg_file}.strip.$$"
  grep -viE "$pattern" "$msg_file" | git stripspace > "$tmp" && mv "$tmp" "$msg_file"
fi
exit 0
