{
    "name": "react-native-pdf-jsi",
    "version": "6.0.0",
    "summary": "React Native PDF viewer and toolkit on Nitro and Fabric. Requires the New Architecture.",
    "description": "PDF viewer and toolkit for React Native. Nitro HybridObjects own documents, downloads and editing; a tiled Fabric viewer renders on Android (PDFium) and iOS (PDFKit). Requires the New Architecture.",
    "main": "lib/commonjs/index.js",
    "module": "lib/module/index.js",
    "types": "lib/typescript/src/index.d.ts",
    "react-native": "src/index.ts",
    "source": "src/index.ts",
    "app": {
        "plugin": "./plugin/build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/126punith/react-native-pdf-jsi.git"
    },
    "keywords": [
        "react-native-pdf",
        "react-native-pdf-viewer",
        "react-native-pdf-jsi",
        "react-native-pdf-enhanced",
        "pdf-viewer",
        "pdf-reader",
        "pdf-view",
        "react-component",
        "react-native",
        "react-native-module",
        "react-native-library",
        "android",
        "ios",
        "nitro",
        "fabric",
        "pdf",
        "view",
        "viewer",
        "jsi",
        "javascript-interface",
        "performance",
        "enhanced",
        "native",
        "bridge",
        "high-performance",
        "fast-pdf",
        "lazy-loading",
        "smart-caching",
        "progressive-loading",
        "memory-optimization",
        "zero-bridge",
        "native-module",
        "cross-platform",
        "mobile",
        "document-viewer",
        "pdf-renderer",
        "pdf-display",
        "large-files",
        "optimization",
        "caching",
        "persistent-cache",
        "react-native-pdf-jsi-enhanced",
        "expo",
        "expo-plugin"
    ],
    "author": {
        "name": "Punith M",
        "email": "punithm300@gmail.com",
        "url": "https://github.com/126punith"
    },
    "license": "MIT",
    "homepage": "https://github.com/126punith/react-native-pdf-jsi",
    "bugs": {
        "url": "https://github.com/126punith/react-native-pdf-jsi/issues"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.25.3",
        "@babel/preset-react": "^7.24.7",
        "@babel/preset-typescript": "^7.24.7",
        "@babel/runtime": "^7.25.0",
        "@expo/config-plugins": "^9.0.0",
        "@types/jest": "^29.5.13",
        "@types/react": "^19.1.1",
        "jest": "^29.7.0",
        "nitrogen": "^0.37.1",
        "react": "19.1.1",
        "react-native": "0.82.1",
        "react-native-builder-bob": "^0.40.13",
        "react-native-nitro-modules": "^0.37.1",
        "typescript": "^5.8.3"
    },
    "scripts": {
        "test": "jest",
        "test:jvm": "example/android/gradlew -p android/jvm-tests test",
        "typecheck": "tsc --noEmit",
        "build": "bob build",
        "build:plugin": "tsc -p plugin/tsconfig.json",
        "nitrogen": "nitrogen",
        "prepare": "bob build",
        "prepublishOnly": "npm run nitrogen && npm run build:plugin && npm run typecheck && npm test",
        "clean:for-publish": "node -e \"const fs=require('fs'),path=require('path');['android/.cxx','android/.gradle','android/build'].forEach(p=>{try{fs.rmSync(path.join(__dirname,p),{recursive:true});console.log('Removed',p);}catch(e){}})\"",
        "prepack": "npm run clean:for-publish",
        "test:native": "./scripts/run-native-tests.sh",
        "test:e2e": "./scripts/run-maestro.sh"
    },
    "peerDependencies": {
        "expo": ">=52.0.0",
        "react": "*",
        "react-native": ">=0.76.0",
        "react-native-nitro-modules": "^0.37.1"
    },
    "peerDependenciesMeta": {
        "expo": {
            "optional": true
        }
    },
    "files": [
        "src/",
        "lib/",
        "!src/__tests__/",
        "!**/__tests__/",
        "android/",
        "!android/build",
        "!android/.cxx",
        "!android/.gradle",
        "!android/src/test/",
        "!android/jvm-tests/",
        "ios/",
        "nitrogen/",
        "nitro.json",
        "fabric/",
        "plugin/",
        "app.plugin.js",
        "react-native-pdf-jsi.podspec",
        "README.md",
        "MIGRATION-6.0.md",
        "EXPO-6.0.md",
        "MIGRATION-5.0.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "codegenConfig": {
        "name": "rnpdf",
        "type": "components",
        "jsSrcsDir": "./fabric",
        "android": {
            "javaPackageName": "org.wonday.pdf"
        },
        "ios": {
            "componentProvider": {
                "RNPDFPdfView": "RNPDFPdfView",
                "RNPDFPdfPageView": "RNPDFPdfPageView"
            }
        }
    },
    "jest": {
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/src"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/lib/"
        ]
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "commonjs",
            "module",
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ],
        "exclude": "**/{__tests__,__fixtures__,__mocks__}/**"
    }
}
